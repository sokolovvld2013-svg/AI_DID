.ruff_cache/
.mypy_cache/
.tox/
.ipynb_checkpoints/
*.pt
*.onnx

# Покрытие тестов
.coverage
.coverage.*
htmlcov/
coverage.xml

# Загружаемые пользователями файлы.
# Правило глобальное намеренно: под каталог выше их класть нельзя, а лишний
# .docx в корне — это внутренний документ. Если понадобится держать в репозитории
# образец, исключите его адресно: !tests/fixtures/образец.docx
*.xlsx
*.xls
*.mp3
*.wav
*.m4a
*.ogg
*.flac
*.pdf
*.docx

# Логи и отладка
*.log
scripts/_debug*
*.tmp
*.bak
*.orig
*.rej
*~
~$*
