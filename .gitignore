# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Окружение и секреты
.env
.env.*
!.env.example
# Старые бэкапы .env (например .envold) — как и .env, не публиковать
.envold
.env.old
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Виртуальное окружение. Именно venv311 попал в историю этого репозитория
# (114 МБ чужих DLL), поэтому перекрываем любое имя, а не только venv/.
venv*/
.venv*/
ENV/
env/

# IDE
.idea/
.vscode/
.vs/
.cursor/
*.swp
*.swo
*.user
*.suo

# ОС
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk

# Данные приложения (не коммитить). Список каталогов взят из config.py:
# MODELS_DIR, CHROMA_PERSIST_DIR, *_UPLOAD_DIR, *_CACHE_DIR, USER_LOGS_DIR.
chroma_data/
models/
procurement/cache/
procurement/uploaded/
procurement/policy/
tenders/cache/
tenders/uploaded/
secretary/uploaded/*
!secretary/uploaded/.gitkeep
lawyer/uploaded/*
!lawyer/uploaded/.gitkeep
economist/uploaded/*
!economist/uploaded/.gitkeep
# Очередь заданий парсера КАД (KAD_ARBITR_DATA_DIR): задания и выгрузки с
# ИНН участников — это рабочие данные, в репозитории им не место.
lawyer/arbitr/data/
logs/*
!logs/.gitkeep

# Учётные записи и настройки
users.json
users.json.*
app_settings.json
app_settings.json.*

# Заменённый логотип
static/img/logo_custom.*
static/img/logo_custom.*.tmp

# Служебное
Защита проекта/
.playwright-mcp/

