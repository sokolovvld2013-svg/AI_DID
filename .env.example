# === LLM (Секретарь, Юрист) ===
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat
# Модели, разрешённые в настройках (как в кабинете проекта). Пустое значение — не ограничивать.
# GIGACHAT_AVAILABLE_MODELS=GigaChat-2,GigaChat-2-Pro,GigaChat-2-Max,GigaChat-3-Ultra
# DEEPSEEK_AVAILABLE_MODELS=deepseek-flash,deepseek-v4-pro

# === Вход по логину и паролю ===
# Включён по умолчанию. Пока пользователей нет, все страницы отдают 503 —
# создать первого администратора:  python -m scripts.manage_users add <логин> --admin
AUTH_ENABLED=true
# AUTH_SECRET — свой ключ подписи cookie сессии (openssl rand -hex 32).
# Не задан — ключ создаётся один раз и хранится в users.json.
# AUTH_SECRET=
# AUTH_SESSION_MAX_AGE=43200
# true — cookie только по HTTPS. Включите вместе с AUTH_COOKIE_SECURE,
# иначе пароль передаётся по сети открытым текстом.
# AUTH_COOKIE_SECURE=false
# AUTH_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_SEC=300
# AUTH_MIN_PASSWORD_LEN=8
# AUTH_ADMIN_ONLY_SETTINGS=true
# USERS_FILE=

# === Эмбеддинги (Юрист, RAG) ===
# На VPS без GPU: gigachat или openai — достаточно pip install -r requirements.txt
EMBEDDING_PROVIDER=gigachat
# EMBEDDING_PROVIDER=local
# Локально: pip install -r requirements-local-embeddings.txt (PyTorch CPU, без nvidia_*)
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# Эксперимент: эмбеддинги GigaChat (нужен GIGACHAT_CREDENTIALS; после смены — очистить индекс и загрузить документы заново)
# EMBEDDING_PROVIDER=gigachat
# GIGACHAT_EMBEDDING_MODEL=Embeddings
# GIGACHAT_EMBEDDING_MODEL=EmbeddingsGigaR
# GIGACHAT_MAX_EMBED_TOKENS=500
# GIGACHAT_MAX_EMBED_CHARS=480
# LOCAL_EMBEDDING_MODEL=models/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_LOCAL_FILES_ONLY=1
# EMBED_BATCH_SIZE=16
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DOWNLOAD_TIMEOUT=300

# === Whisper (Секретарь) — на VPS быстрее base + beam 1, чем small + beam 5 ===
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
# WHISPER_CPU_THREADS=0
# WHISPER_VAD_FILTER=true
# WHISPER_CONDITION_ON_PREVIOUS=false
# WHISPER_PRELOAD=true
# WHISPER_LOG_EVERY_N_SEGMENTS=15
# tiny — ещё быстрее, но хуже качество; cuda + float16 — при наличии GPU

# === Экономист ===
ECONOMIST_FACT_SHEET_URL=https://docs.google.com/spreadsheets/d/ВАШ_ID/edit
N8N_ECONOMIST_WEBHOOK_URL=https://ваш-n8n.example/webhook/economist
N8N_ECONOMIST_TIMEOUT=120

# === Юрист ===
LAWYER_CITATION_LLM_REPAIR=true
# RAG: чанки и векторный поиск (после смены LAWYER_CHUNK_* — очистить индекс и загрузить документы заново)
# LAWYER_CHUNK_SIZE=1200
# LAWYER_CHUNK_OVERLAP=200
# LAWYER_RETRIEVE_K=80
# LAWYER_CONTEXT_K=8
# LAWYER_SEMANTIC_WEIGHT=0.45
# LAWYER_SEMANTIC_MIN_SCORE=0.42
# LAWYER_SEMANTIC_TOP_K=6
# LAWYER_BALANCE_FILES=false
# LAWYER_LLM_QUERY_REWRITE=true
# LAWYER_CONTEXT_MERGE_NEIGHBORS=1
# MAX_LAWYER_CITATION_CHARS=2500
# MAX_LAWYER_LLM_CONTEXT_CHARS=28000
# Полный текст документации в проверке Закупки/Торгов (символы)
# CHECK_LLM_CONTEXT_CHARS=500000
# MAX_LAWYER_PAGES=200
# OCR сканов на VPS (при «Killed» в логе):
# LAWYER_OCR_SCALE=1.0
# LAWYER_OCR_MAX_SIDE=1200
# LAWYER_OCR_MAX_PAGES=8
# LAWYER_OCR_PAGE_TIMEOUT_SEC=180
# LAWYER_OCR_SUBPROCESS=true

# === Лимиты загрузки (байты) ===
# MAX_DOCUMENT_SIZE=52428800
# MAX_AUDIO_SIZE=104857600

# === Закупка 223-ФЗ ===
# PROCUREMENT_ACCESS_TOKEN=
# PROCUREMENT_CACHE_TTL_HOURS=24
# PROCUREMENT_HISTORY_SIZE=3

# === Парсер КАД (арбитражные дела) ===
# false — вкладка «Арбитражные дела» скрыта, маршруты агента отвечают 404.
# Включайте только вместе с токенами машин и HTTPS (Cloudflare Tunnel).
KAD_AGENT_ENABLED=false
# Своя строка на машину, разделитель — запятая. Сгенерировать:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Имя машины пишется в историю заданий, поэтому оно узнаваемое: ivan-pc.
# KAD_AGENT_TOKENS=ivan-pc:TOKEN1,petr-pc:TOKEN2
# Сколько агент держит запрос открытым, ожидая задание, с (потолок 60).
# KAD_AGENT_HOLD=30
# Как часто агент подтверждает, что жив, с.
# KAD_AGENT_HEARTBEAT=30
# После какой тишины машина считается отключённой, с.
# KAD_AGENT_STALE=180
# Сколько дней хранить выгрузки, 0 — не удалять.
KAD_ARBITR_RETENTION_DAYS=10
# Сколько ждать задание в очереди без агента, ч, потом отметить истёкшим.
KAD_ARBITR_QUEUE_TTL_HOURS=24
# Потолок на Excel от агента, МБ.
KAD_ARBITR_MAX_FILE_MB=20
# Потолок на число дел в одном задании.
KAD_ARBITR_MAX_RECORDS=2000

# === Прочее ===
# APP_TIMEZONE=Europe/Moscow
# CHROMA_PERSIST_DIR=chroma_data
# HISTORY_SIZE=5
# LOGO_SOURCE=static/img/logo.png
# FAVICON_SOURCE=static/img/favicon.png
