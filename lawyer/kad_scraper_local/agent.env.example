# Настройки локального агента парсера КАД.
# Скопируйте этот файл как agent.env и впишите свои значения.
# setup.cmd делает это за вас, спрашивая значения.

# Адрес сервера. Пока нет HTTPS-туннеля, для проверки на своей машине:
#   http://127.0.0.1:8000
# В бою это будет адрес через Cloudflare, например https://kad.example.com
KAD_AGENT_SERVER=http://127.0.0.1:8000

# Пароль машины. Только латиница! Кириллица не допускается в HTTP-заголовке.
# Должен совпадать с одним из паролей в KAD_AGENT_TOKENS на сервере.
KAD_AGENT_TOKEN=CHANGE-ME-to-a-long-random-ascii-token

# Имя машины. Должно совпадать с именем в KAD_AGENT_TOKENS на сервере.
# Если оставить пустым, возьмётся имя компьютера в сети.
KAD_AGENT_NAME=ivan-pc

# Логин сотрудника, которому принадлежит машина. Его задания приходят первыми.
# Необязательно: если пусто, машина берёт любые задания.
KAD_AGENT_OWNER=demo

# Журнал агента. Без него агент, запущенный из Планировщика заданий, ничего
# не напечатает и при сбое не оставит следов.
KAD_AGENT_LOG=logs\agent.log